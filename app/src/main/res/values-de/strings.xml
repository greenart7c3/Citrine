    <string name="relay_aggregator_kinds_empty_hint">Eine leere Liste abonniert alle Kinds</string>
    <string name="relay_aggregator_extra_relays">Zusätzliche Relays</string>
    <string name="relay_aggregator_extra_relays_description">Relays, die mit einem einfachen Kinds/Since-Filter (ohne Autorenfilter) abonniert werden. Werden als vollständige Relay-Liste verwendet, wenn kein Pubkey konfiguriert ist.</string>
    <string name="relay_aggregator_extra_relays_hint">Füge mindestens ein Relay hinzu, um ohne Pubkey zu laufen</string>
    <string name="relay_aggregator_source_relays">Aggregator-Relays</string>
    <string name="relay_aggregator_source_relays_description">Externe Aggregator-Relays (zum Beispiel aggr.nostr.land), die Events von vielen Quellen spiegeln. Werden für jeden konfigurierten Kind mit deiner vollständigen Follow-Liste abonniert.</string>
    <string name="relay_aggregator_indexer_relays">NIP-65-Indexer-Relays</string>
    <string name="relay_aggregator_indexer_relays_description">Werden nur verwendet, um die NIP-65-Relay-Listen, Kontaktlisten und Stummschaltlisten von Autoren nachzuschlagen, wenn diese noch nicht zwischengespeichert sind. Leer lassen, um die integrierten Standardwerte zu verwenden.</string>
